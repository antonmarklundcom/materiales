# Defensa en profundidad: en este plan de Hostinger el repo entero vive DENTRO del docroot
# (ver DEPLOY.md), así que la carpeta queda no-pública por las reglas [F] de .htaccess en la
# raíz Y por este Require all denied — si una de las dos falla, la otra sigue protegiendo.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>

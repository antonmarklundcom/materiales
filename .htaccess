# .htaccess — reescrituras del router (plan §2). Docroot = repo root (ver DEPLOY.md: el
# Git de Hostinger en hosting compartido sólo permite desplegar DENTRO de public_html, así
# que el repo entero vive en el docroot. data/, content/, config/, storage/, tools/,
# prompts/, docs/ y los .md siguen siendo internos: los bloquea el bloque de abajo, no la
# ubicación en disco.

Options -Indexes
DirectoryIndex index.php
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Nada de lo interno se sirve por URL: datos, contenido, config/secretos, storage
  # (leads.log), herramientas de dev/CI, tests locales, prompts, docs, control de versiones
  # ni markdown. [NC] porque el bloqueo por prefijo es la única defensa real de storage/ y no
  # debe depender de que el filesystem sea case-sensitive.
  RewriteRule ^(data|content|config|storage|tools|tests|prompts|docs)(/|$) - [NC,F,L]
  RewriteRule (^|/)\.(git|github|gitignore)(/|$) - [NC,F,L]
  RewriteRule \.md$ - [NC,F,L]
  RewriteRule ^config\.sample\.php$ - [NC,F,L]
  # R4: copias de respaldo, scripts, logs y dumps en CUALQUIER ruta (un index.php.bak
  # olvidado serviría el código fuente). Misma lista en el <FilesMatch> de abajo y en
  # tools/router-cli.php; tools/check-rewrites.php (CI) verifica que coincidan.
  RewriteRule (\.(bak|orig|sh|log|sql|swp)|~)$ - [NC,F,L]

  # Nunca servir directamente los includes del router ni los partials.
  RewriteRule ^materiales/_index\.php$ - [F,L]
  RewriteRule ^partials/ - [F,L]

  # sitemap.xml lo genera PHP desde los mismos archivos de datos (no puede desincronizarse).
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # Canonicalización: /materiales/hierro → /materiales/hierro/ (301, una sola forma de URL).
  RewriteCond %{REQUEST_URI} ^/(materiales|guias|calculadoras)/[a-z0-9-]+$
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # Índices.
  RewriteRule ^materiales/$ materiales/index.php [L,QSA]
  RewriteRule ^guias/$ guias/index.php [L,QSA]
  RewriteRule ^calculadoras/$ calculadoras/index.php [L,QSA]

  # Namespace plano: /materiales/{slug}/ sirve categorías Y materiales (plan §2).
  RewriteRule ^materiales/([a-z0-9-]+)/$ materiales/index.php?slug=$1 [L,QSA]
  RewriteRule ^guias/([a-z0-9-]+)/$ guias/index.php?slug=$1 [L,QSA]
  RewriteRule ^calculadoras/([a-z0-9-]+)/$ calculadoras/index.php?slug=$1 [L,QSA]
</IfModule>

# R4, segunda capa por si mod_rewrite no corre: la misma lista que la regla de arriba.
<FilesMatch "(?i)(\.(bak|orig|sh|log|sql|swp)|~)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Fase 14 (decisión §1.24-§1.26): el sitio no usa iframes de terceros ni pide ninguno de
  # estos permisos, así que negarlos de entrada no rompe nada.
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # HSTS queda comentado a propósito: activarla a ciegas en hosting compartido puede dejar el
  # sitio inaccesible si el SSL falla o se desconfigura. Descomentar recién cuando el
  # certificado esté confirmado y estable en producción (ver DEPLOY.md).
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Sin Content-Security-Policy: el JSON-LD inline y la inyección de GA4/Pixel post-consentimiento
  # hacen que una CSP estricta sea un proyecto aparte (plan §10 Backlog).
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/xml application/xml application/xhtml+xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE image/svg+xml application/json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

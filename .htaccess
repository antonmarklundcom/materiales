# .htaccess — reescrituras del router (plan §2). Docroot = repo root (ver DEPLOY.md: el
# Git de Hostinger en hosting compartido sólo permite desplegar DENTRO de public_html, así
# que el repo entero vive en el docroot. data/, content/, config/, storage/, tools/,
# prompts/, docs/ y los .md siguen siendo internos: los bloquea el bloque de abajo, no la
# ubicación en disco.

Options -Indexes
DirectoryIndex index.php
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # S1 — una sola forma de URL: https y sin www, con 301 (antes dependía del toggle "Force
  # HTTPS" de hPanel, que un redeploy del .htaccess puede pisar). Primero www → apex en https
  # (un solo salto), después http → https. X-Forwarded-Proto cubre el caso de un proxy/CDN
  # que termina el SSL adelante. tools/router-cli.php no los replica: en dev/CI no hay SSL
  # ni www. Los verifica tools/prod-check.sh contra producción.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} ^materiales\.com\.py$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Nada de lo interno se sirve por URL: datos, contenido, config/secretos, storage
  # (leads.log), herramientas de dev/CI, tests locales, prompts, docs, control de versiones
  # ni markdown. [NC] porque el bloqueo por prefijo es la única defensa real de storage/ y no
  # debe depender de que el filesystem sea case-sensitive.
  RewriteRule ^(data|content|config|storage|tools|tests|prompts|docs)(/|$) - [NC,F,L]
  RewriteRule (^|/)\.(git|github|gitignore)(/|$) - [NC,F,L]
  RewriteRule \.md$ - [NC,F,L]
  RewriteRule ^config\.sample\.php$ - [NC,F,L]
  # R4: copias de respaldo, scripts, logs y dumps en CUALQUIER ruta (un index.php.bak
  # olvidado serviría el código fuente). Misma lista en el <FilesMatch> de abajo y en
  # tools/router-cli.php; tools/check-rewrites.php (CI) verifica que coincidan.
  RewriteRule (\.(bak|orig|sh|log|sql|swp)|~)$ - [NC,F,L]

  # Nunca servir directamente los includes del router ni los partials.
  RewriteRule ^materiales/_index\.php$ - [F,L]
  RewriteRule ^partials/ - [F,L]

  # sitemap.xml lo genera PHP desde los mismos archivos de datos (no puede desincronizarse).
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # Canonicalización: /materiales/hierro → /materiales/hierro/ (301, una sola forma de URL).
  RewriteCond %{REQUEST_URI} ^/(materiales|guias|calculadoras)/[a-z0-9-]+$
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # Índices.
  RewriteRule ^materiales/$ materiales/index.php [L,QSA]
  RewriteRule ^guias/$ guias/index.php [L,QSA]
  RewriteRule ^calculadoras/$ calculadoras/index.php [L,QSA]

  # Namespace plano: /materiales/{slug}/ sirve categorías Y materiales (plan §2).
  RewriteRule ^materiales/([a-z0-9-]+)/$ materiales/index.php?slug=$1 [L,QSA]
  RewriteRule ^guias/([a-z0-9-]+)/$ guias/index.php?slug=$1 [L,QSA]
  RewriteRule ^calculadoras/([a-z0-9-]+)/$ calculadoras/index.php?slug=$1 [L,QSA]
</IfModule>

# R4, segunda capa por si mod_rewrite no corre: la misma lista que la regla de arriba.
<FilesMatch "(?i)(\.(bak|orig|sh|log|sql|swp)|~)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Fase 14 (decisión §1.24-§1.26): el sitio no usa iframes de terceros ni pide ninguno de
  # estos permisos, así que negarlos de entrada no rompe nada.
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # HSTS (S1/R7): el sitio sirve por https desde el go-live (2026-09-16) y ahora redirige
  # todo http → https. Sin includeSubDomains ni preload a propósito: no sabemos si todo
  # subdominio (webmail, paneles de Hostinger) tiene certificado, y preload es difícil de
  # deshacer. Los navegadores ignoran la cabecera si llega por http, así que mandarla siempre
  # es inofensivo (y no depende de que el servidor exponga la variable HTTPS).
  Header always set Strict-Transport-Security "max-age=31536000"
  # Sin Content-Security-Policy: el JSON-LD inline y la inyección de GA4/Pixel post-consentimiento
  # hacen que una CSP estricta sea un proyecto aparte (plan §10 Backlog).
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/xml application/xml application/xhtml+xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE image/svg+xml application/json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # S8: CSS/JS van con ?v=<mtime> (asset() en partials/init.php), así que un año es seguro:
  # cada deploy que los cambia cambia la URL. Las fuentes no cambian nunca.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  # Imágenes: sin versión en la URL, 30 días. AVIF es lo que reciben los navegadores de hoy.
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType image/vnd.microsoft.icon "access plus 30 days"
</IfModule>

<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/svg+xml .svg
</IfModule>

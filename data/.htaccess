# Defensa en profundidad: este directorio vive FUERA de public_html (ver DEPLOY.md).
# Si algún despliegue lo dejara dentro del docroot por error, Apache igual lo niega.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
